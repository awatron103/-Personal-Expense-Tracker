        {
            "id": 2,
            "module": "gemini-ai:simpleTextPrompt",
            "version": 1,
            "parameters": {},
            "filter": {
                "name": "Only Allow Allowed Number",
                "conditions": [
                    [
                        {
                            "a": "{{1.messages[].from}}",
                            "b": "YOUR_PHONE_NUMBER_HERE",
                            "o": "text:equal"
                        }
                    ]
                ]
            },
            "mapper": {
                "model": "gemini-2.5-flash",
                "textPrompt": "You are a financial parsing assistant. Extract expense or income details from the following WhatsApp message. \r\n\r\nReturn ONLY a single line of text formatted exactly like a CSV row, using a vertical pipe | as the separator. Do NOT include any markdown, headers, or conversational text. \r\n\r\nFormat: Date|Type|Category|Description|Payment Method|Amount|Notes\r\n\r\nRules:\r\n1. Date: Format as DD-MMM-YYYY (e.g., 12-Oct-2026). If none mentioned, use {{formatDate(now; \"DD-MMM-YYYY\")}}\r\n2. Type: \"Income\" or \"Expense\". If the message is a greeting or irrelevant, output: {{formatDate(now; \"DD-MMM-YYYY\")}}|Ignore|Miscellaneous|Irrelevant|Cash|0|\r\n3. Category: STRICT RESTRICTION. You are FORBIDDEN from using any category not in this exact list:\r\n   - Expense Categories: Rent & Housing, Groceries, Utilities & Bills, Transport & Fuel, Dining Out, Health, Education, Shopping, Entertainment, Subscriptions, Family & Gifts, Miscellaneous\r\n   - Income Categories: Salary, Freelance, Investments, Bonus, Other Income\r\n   *If the text describes an expense that does not perfectly match the list, you MUST categorize it as \"Miscellaneous\". If it is an unlisted income, you MUST use \"Other Income\". Do NOT invent categories.*\r\n4. Description: Short summary.\r\n5. Payment Method: Infer from text. ONLY use: Cash, Debit Card, Bank Transfer, Mobile Wallet. Default to \"Cash\".\r\n6. Amount: Numbers only, no currency symbols or commas.\r\n7. Notes: Brief extra details if provided, otherwise leave blank.\r\n\r\nMessage:\r\n{{1.messages[].text.body}}\n"
            },
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 0
                },
                "setupValidation": {
                    "result": {
                        "valid": true,
                        "fields": []
                    },
                    "version": 1,
                    "configuration": "REDACTED"
                },
                "restore": {
                    "expect": {
                        "model": {
                            "label": "Gemini 2.5 FlashApplies smart reasoning to fast data tasks while ensuring quick response times"
                        }
                    }
                },
                "expect": [
                    {
                        "name": "model",
                        "type": "select",
                        "label": "Model",
                        "required": true,
                        "validate": {
                            "enum": [
                                "gemini-2.5-flash",
                                "gemini-3.8-flash",
                                "gemini-3.7-flash",
                                "gemini-3.6-flash",
                                "gemini-3.5-flash",
                                "gemini-3.1-pro-preview",
                                "gemini-3-flash-preview",
                                "gemini-2.5-pro"
                            ]
                        }
                    },
                    {
                        "name": "textPrompt",
                        "type": "text",
                        "label": "Text prompt",
                        "required": true
                    }
                ]
            }
        },
        {
            "id": 9,
            "module": "google-sheets:addRow",
            "version": 2,
            "parameters": {
                "__IMTCONN__": 0
            },
            "filter": {
                "name": "Only Log Real Expenses",
                "conditions": [
                    [
                        {
                            "a": "{{get(split(2.result; \"|\"); 6)}}",
                            "b": "0",
                            "o": "number:greater"
                        }
                    ]
                ]
            },
            "mapper": {
                "from": "drive",
                "mode": "select",
                "values": {
                    "Date": "{{get(split(2.result; \"|\"); 1)}}",
                    "Type": "{{get(split(2.result; \"|\"); 2)}}",
                    "Notes": "{{get(split(2.result; \"|\"); 7)}}",
                    "Category": "{{get(split(2.result; \"|\"); 3)}}",
                    "Amount (Rs)": "{{get(split(2.result; \"|\"); 6)}}",
                    "Description": "{{get(split(2.result; \"|\"); 4)}}",
                    "Payment Method": "{{get(split(2.result; \"|\"); 5)}}"
                },
                "sheetId": "Transactions",
                "spreadsheetId": "/YOUR_SPREADSHEET_ID_HERE",
                "includesHeaders": true,
                "insertDataOption": "INSERT_ROWS",
                "useColumnHeaders": true,
                "valueInputOption": "USER_ENTERED",
                "insertUnformatted": false
            },
            "metadata": {
                "designer": {
                    "x": 600,
                    "y": 0
                }
            }
        }
